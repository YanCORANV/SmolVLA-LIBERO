+def _prepare_run_metadata(output_dir, expected_meta, historical_freeze_sha256):
+    """Preserve failed v1 provenance and permit exactly one zero-commit v2 transition."""
+    meta_path = output_dir / "experiment_meta.json"
+    if not meta_path.exists():
+        atomic_json(meta_path, {
+            **expected_meta,
+            "created_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        })
+        return meta_path
+    saved = json.loads(meta_path.read_text(encoding="utf-8"))
+    if all(saved.get(key) == value for key, value in expected_meta.items()):
+        return meta_path
+    historical = {**expected_meta, "freeze_record_sha256": historical_freeze_sha256}
+    if any(saved.get(key) != value for key, value in historical.items()):
+        raise RuntimeError("Existing final run has different frozen provenance")
+    v2_path = output_dir / "experiment_meta_v2.json"
+    v2_expected = {
+        **expected_meta,
+        "historical_failed_meta_sha256": file_sha256(meta_path),
+        "historical_completed_rollouts": 0,
+        "historical_failure": "State 33 reset before policy inference; no action or outcome observed",
+    }
+    if v2_path.exists():
+        current = json.loads(v2_path.read_text(encoding="utf-8"))
+        if any(current.get(key) != value for key, value in v2_expected.items()):
+            raise RuntimeError("Existing v2 final run has different frozen provenance")
+    else:
+        if any(output_dir.glob("*/task_00/state_*/attempt_*/complete.json")):
+            raise RuntimeError("Cannot transition a final run with committed v1 rollouts")
+        atomic_json(v2_path, {
+            **v2_expected,
+            "created_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        })
+    return v2_path
+
